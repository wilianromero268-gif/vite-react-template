# Copia este archivo como .env y completa tus valores.
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
SESSION_SECRET=CAMBIA_ESTO_POR_UN_SECRETO_ALEATORIO_LARGO

# Google Cloud OAuth 2.0 (tipo aplicación web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Correos administradores separados por coma. Los admins no tienen límite diario.
ADMIN_EMAILS=
DAILY_LIMIT=450

# URL completa del proveedor upstream de cada endpoint.
# Debe aceptar el parámetro indicado (q o url) como query string.
YTSEARCH_UPSTREAM=
YTMP3_UPSTREAM=
YTMP4_UPSTREAM=
FACEBOOK_UPSTREAM=
TIKTOK_UPSTREAM=
INSTAGRAM_UPSTREAM=
SPOTIFY_UPSTREAM=
